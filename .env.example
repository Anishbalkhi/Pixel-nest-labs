# Copy to .env.local and fill in. Never commit real keys.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# Form submissions go to a Google Apps Script web app (google-apps-script/Code.gs),
# which writes them to the Google Sheet and emails the team. See the README.
GOOGLE_SCRIPT_URL=
# Any long random string. Put the same value in the script's Script properties as SECRET.
GOOGLE_SCRIPT_SECRET=
